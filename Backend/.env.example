# Django
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite default; set MySQL env vars for CodeRed-style deploys)
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=3306

# CORS / CSRF (Next.js frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Wagtail
WAGTAIL_SITE_NAME=soreal
WAGTAILADMIN_BASE_URL=http://localhost:8000

# Blacklist access password (optional section-wide gate)
# BLACKLIST_ACCESS_PASSWORD=change-me

# Email (console backend in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost
